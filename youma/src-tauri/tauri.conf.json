{
  "productName": "Youma",
  "identifier": "ai.youma.app",
  "version": "0.1.0",
  "build": {
    "beforeBuildCommand": "npm --prefix ui run build",
    "beforeDevCommand": "npm --prefix ui run dev",
    "devUrl": "http://127.0.0.1:6005",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self' tauri: asset:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' https: http://127.0.0.1:* ws://127.0.0.1:*; media-src 'self' blob:; img-src 'self' data: blob: https:; font-src 'self' data:; worker-src 'self' blob:"
    },
    "windows": [
      {
        "label": "main",
        "title": "Youma",
        "width": 32,
        "height": 32,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": false,
        "backgroundColor": "#00000000"
      },
      {
        "label": "panel",
        "title": "Youma",
        "width": 420,
        "height": 700,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "resizable": false,
        "visible": false,
        "skipTaskbar": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
